{
    "name": "@boytecht/threeengine-configurator",
    "description": "ThreeEngine configurator - fork of @threepipe/plugin-configurator for CanvasX. Plugins for creating material and object configurators in threepipe.",
    "version": "1.0.0",
    "devDependencies": {},
    "dependencies": {
        "threepipe": "file:./../../src/",
        "tippy.js": "^6.3.7"
    },
    "peerDependencies": {
        "@boytecht/threeengine": ">=1.0.0"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies"
        ],
        "replace": {
            "dependencies": {}
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md",
        "docs",
        "tsconfig.json",
        "NOTICE",
        "LICENSE"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build",
        "dev": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "vite",
        "plugin"
    ],
    "bugs": {
        "url": "https://github.com/jayhirpara28/threeengine/issues"
    },
    "homepage": "https://github.com/jayhirpara28/threeengine#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jayhirpara28/threeengine.git",
        "directory": "plugins/configurator"
    },
    "publishConfig": {
        "access": "public"
    }
}
